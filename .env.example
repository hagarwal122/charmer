# Charmer settings. Copy to .env and fill in. Never commit .env. A provider left empty is left out of the pool.
LITELLM_MASTER_KEY=
# The dashboard sign-in. Both required; the password 16+ characters (openssl rand -base64 36).
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_SECRET=
CHARMER_METRICS_KEY=
ALERT_WEBHOOK_URL=
CLOUDFLARE_TUNNEL_ID=
# Optional: the dashboard on its own tunnel (docs/guide.md §7). Empty leaves the dashboard unpublished.
CLOUDFLARE_DASHBOARD_TUNNEL_ID=

# The one key your app sends (Authorization: Bearer ...). Put the same value in your app's own env. make key-new prints one.
CHARMER_API_KEY=

# Provider keys, one account each
OPENROUTER_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
ZAI_API_KEY=
NVIDIA_NIM_API_KEY=
CF_API_TOKEN=
CF_AI_API_BASE=
CF_ACCOUNT_ID=
CF_ANALYTICS_TOKEN=

# Dashboard: the time zone its clocks and hour labels use
CHARMER_DASHBOARD_TZ=UTC
# Host ports (127.0.0.1 only). Change them if 4000 or 8080 is taken on this machine.
CHARMER_LITELLM_PORT=4000
CHARMER_DASHBOARD_PORT=8080
# 1 only when your own HTTPS proxy (not cloudflared) sits in front of the dashboard: marks the session cookie Secure
DASHBOARD_TRUST_PROXY=0
# Set by the Makefile to your uid and gid (cloudflared reads its credentials as you). Leave empty.
CHARMER_UID=
CHARMER_GID=
